# Optional helper for Windows (Ansible has no native Windows support).
# Contains ansible + docker CLI + compose plugin; talks to the host Docker via the mounted socket.
FROM docker:cli AS dockercli

FROM python:3.12-slim
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
RUN pip install --no-cache-dir ansible-core docker requests \
 && ansible-galaxy collection install community.docker
WORKDIR /work
ENTRYPOINT ["ansible-playbook"]
